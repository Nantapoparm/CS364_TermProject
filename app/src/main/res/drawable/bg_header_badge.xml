<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/retro_cream" />
            <stroke android:width="@dimen/border" android:color="@color/retro_border" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/retro_orange" />
            <stroke android:width="@dimen/border" android:color="@color/retro_border" />
        </shape>
    </item>
</selector>
