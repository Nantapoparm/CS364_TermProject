<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/screen_gutter">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/PixelTitle"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:text="@string/camera_title" />

            <TextView
                style="@style/RetroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/camera_subtitle" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_header_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_header_badge"
            android:contentDescription="@string/tap_to_shoot"
            android:padding="12dp"
            android:src="@drawable/ic_camera" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_window"
        android:orientation="vertical"
        android:paddingLeft="@dimen/border"
        android:paddingTop="@dimen/border"
        android:paddingRight="9dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_window_titlebar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="@dimen/border">
            <TextView
                style="@style/MonoLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/camera_window"
                android:textSize="13sp" />

            <TextView style="@style/WindowControl" android:text="@string/win_minimize" />
            <TextView style="@style/WindowControl" android:text="@string/win_maximize" />
            <TextView style="@style/WindowControl" android:text="@string/win_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">
            <FrameLayout
                android:id="@+id/viewfinder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_image_border"
                android:padding="@dimen/border">
                <ImageView
                    android:id="@+id/viewfinder_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/placeholder_image" />

                <View
                    android:id="@+id/flash_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@color/white" />

                <LinearLayout
                    android:id="@+id/permission_panel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/camera_permission_needed"
                        android:textColor="@color/retro_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_allow_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_btn_retro"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="18dp"
                        android:paddingRight="22dp"
                        android:paddingBottom="@dimen/button_shadow"
                        android:text="@string/allow_camera"
                        android:textColor="@color/retro_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_corner" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="56dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"
                    android:rotation="90"
                    android:src="@drawable/ic_corner" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no"
                    android:rotation="270"
                    android:src="@drawable/ic_corner" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">
                    <View
                        android:id="@+id/live_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_live_dot" />

                    <TextView
                        style="@style/MonoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pixel_live" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_zoom"
                    style="@style/MonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_box"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/shot_counter"
                    style="@style/MonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pixel_size"
                    android:textColor="@color/retro_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/pick_style"
                    android:textColor="@color/retro_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/btn_bit_8" style="@style/BitButton" android:text="@string/bit_8" />
                <Space android:layout_width="10dp" android:layout_height="0dp" />
                <TextView android:id="@+id/btn_bit_16" style="@style/BitButton" android:text="@string/bit_16" />
                <Space android:layout_width="10dp" android:layout_height="0dp" />
                <TextView android:id="@+id/btn_bit_32" style="@style/BitButton" android:text="@string/bit_32" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/recent_thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_image_border"
                android:contentDescription="@string/latest_photo"
                android:padding="@dimen/border"
                android:scaleType="fitXY"
                android:src="@drawable/placeholder_image" />

            <TextView
                style="@style/RetroCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/latest_photo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_shutter_outer"
                android:paddingLeft="9dp"
                android:paddingTop="9dp"
                android:paddingRight="15dp"
                android:paddingBottom="15dp">
                <ImageView
                    android:id="@+id/btn_shutter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shutter_inner"
                    android:contentDescription="@string/tap_to_shoot"
                    android:padding="16dp"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>

            <TextView
                style="@style/RetroCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tap_to_shoot"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btn_switch_camera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_box_thick"
                android:contentDescription="@string/switch_camera"
                android:padding="13dp"
                android:src="@drawable/ic_switch_camera" />

            <TextView
                style="@style/RetroCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/switch_camera" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
