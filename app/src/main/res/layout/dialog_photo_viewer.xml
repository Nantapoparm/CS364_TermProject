<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_gutter">
    <LinearLayout
        android:id="@+id/viewer_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_window"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/border"
        android:paddingTop="@dimen/border"
        android:paddingRight="9dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_window_titlebar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:paddingBottom="@dimen/border">
            <TextView
                android:id="@+id/viewer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/retro_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/viewer_close"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/viewer_close"
                android:gravity="center"
                android:text="@string/win_close"
                android:textColor="@color/retro_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/viewer_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_image_border"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/border"
                    android:scaleType="fitCenter"
                    app:layout_constraintDimensionRatio="3:4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/viewer_like"
                    style="@style/BitButton" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/viewer_delete"
                    style="@style/BitButton"
                    android:text="@string/viewer_delete" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/viewer_done"
                    style="@style/BitButton"
                    android:text="@string/viewer_close" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
